# Supabase Supavisor transaction pooler URL for application connections.
# Use port 6543 and include pgbouncer=true.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct or session-pooler URL for Prisma CLI migrations (port 5432).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth project settings (use the project URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"

# Server-side OpenRouter key used for Gemini 3.1 Flash Lite quiz generation.
OPENROUTER_API_KEY="<openrouter-api-key>"
